<playhand-button>
  <button class="playhand-btn">Play Hand</button>
</playhand-button>

<script>
  import { $deck, $remainingDeck, $discardedCard } from '../utils/deckStores.js'
  import { $handLimit, $currentHand, $currentPlayed, $playedCard, $selectedCard } from '../utils/handStores.js'
  import { $roundScore, $round } from '../utils/gameStores.js'
  import { winCond } from '../utils/blind.js'
  import { count, drawCard, baseDeck } from '../utils/card.js'
  import { whichPoker } from '../utils/poker.js'
  import { drawing } from '../utils/index.js'

  class PlayhandButton extends HTMLElement {
    constructor() {
      super()

      const button = this.querySelector('button.playhand-btn')

      button.addEventListener('click', () => {
        // set the discardedCard stores to cards and set currentHand stores to the currently discarded card minus the currentHand
        $currentHand.set($currentHand.get() - $selectedCard.get().length)
        //console.log($currentHand.get())

        let selected = document.querySelectorAll('card-button>button')
        let played = $selectedCard.get()
        //console.log(selected, played)

        // get the poker hand
        console.log($selectedCard.get(), whichPoker($selectedCard.get()), played)

        //count the score logic
        let countnow = count($selectedCard.get())
        $roundScore.set(countnow)
        //let win = winCond(countnow, 10)
        //
        //if(win === true) {
        //  $round.set($round.get() + 1)
        //}

        //if the value is included in $selectedCard
        //delete the element which has the value
        selected.forEach(card => {
          if ($selectedCard.get().includes(card.value)) {
            played.splice(played.indexOf(card.value), 1)
            card.parentElement.remove()
            //console.log(card.value)
          }
        })
        //console.log(played)
        $selectedCard.set(played)

        // get how many card can i draw
        let { drawedCard, deck } = drawCard($deck.get(), $handLimit.get() - $currentHand.get())
        $remainingDeck.set(deck.length)
        $deck.set(deck)
        $currentHand.set($currentHand.get() + drawedCard.length)
        //console.log($currentHand.get(), drawedCard)

        // draw the card from deck
        drawing(drawedCard)
      })
    }
  }

  customElements.define('playhand-button', PlayhandButton)
</script>
