<discard-button>
  <button class="discard-btn">Discard</button>
</discard-button>

<script>
  import { $deck, $remainingDeck, $discardedCard } from '../utils/deckStores.js'
  import { $handLimit, $currentHand, $selectedCard, $cardInHand  } from '../utils/handStores.js'
  import { drawCard } from '../utils/card.js'
  import { drawing } from '../utils/index.js'

  class DiscardButton extends HTMLElement {
    constructor() {
      super()

      const button = this.querySelector('button.discard-btn')

      button.addEventListener('click', () => {
        // set the discardedCard stores to cards and set currentHand stores to the currently discarded card minus the currentHand
        $currentHand.set($currentHand.get() - $selectedCard.get().length)
        //console.log($currentHand.get())

        let selected = document.querySelectorAll('card-button>button')
        let discarded = $selectedCard.get()
        let inHand = $cardInHand.get()
        //console.log(selected, discarded, $cardInHand.get(), inHand)

        //if the value is included in $selectedCard
        //delete the element which has the value
        selected.forEach(card => {
          if (discarded.includes(card.value)) {
            inHand.splice(inHand.indexOf(card.value), 1)
            card.parentElement.remove()
            //console.log(card.value)
          }
        })
        //console.log($cardInHand.get(), inHand)
        $selectedCard.set([])

        // get how many card can i draw
        let { drawedCard, deck } = drawCard($deck.get(), $handLimit.get() - $currentHand.get())
        $remainingDeck.set(deck.length)
        $deck.set(deck)
        $currentHand.set($currentHand.get() + drawedCard.length)
        //console.log($currentHand.get(), drawedCard)

        // draw the card from deck
        drawing(drawedCard)
        // set add the new card that is drawn to the cardInHand
        inHand.push(...drawedCard)
        //$cardInHand.set()
        console.log($cardInHand.get(), inHand, discarded)
      })
    }
  }

  customElements.define('discard-button', DiscardButton)
</script>
