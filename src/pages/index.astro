---
import BaseLayout from '../layouts/BaseLayout.astro'
import DrawButton from '../components/DrawButton.astro'
// import ResetButton from '../components/ResetButton.astro'
import DeckID from '../components/DeckID.astro'
import Deck from '../components/Deck.astro'
import HandCard from '../components/HandCard.astro'
import DiscardButton from '../components/DiscardButton.astro'
import PlaycardButton from '../components/PlaycardButton.astro'
import CheckDiscarded from '../components/CheckDiscarded.astro'
import CheckPlayed from '../components/CheckPlayed.astro'
import CheckWin from '../components/CheckWin.astro'
import RunWindow from '../components/RunWindow.astro'
import SortSuit from '../components/SortSuit.astro'
import SortRank from '../components/SortRank.astro'
---

<BaseLayout>
  <div class="flex justify-center">
    <RunWindow />
    <div class="w-2/3 flex justify-center">
      <div class="flex">
        <div class="flex flex-col justify-center">
          <HandCard />
          <div class="flex justify-center">
            <PlaycardButton />
            <div>
              <span>Sort Hand</span>
              <SortSuit />
              <SortRank />
            </div>
             <DiscardButton /> 
          </div>
        </div>
        <div class="w-1/3 flex flex-col content-center">
          <Deck />
        </div>
      </div>
    </div>
  </div>
  <DrawButton />
</BaseLayout>
